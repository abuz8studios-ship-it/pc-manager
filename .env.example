# ABU Master PC Manager — environment configuration
# Copy this file to ".env" (which is git-ignored) and fill in real values.

# Port the dashboard listens on (default 9100)
ABU_PM_PORT=9100

# WSL sudo password used to start/stop/restart the hermes-qadir systemd service.
# REQUIRED only if you use the /api/claw/hermes start|stop|restart actions.
# Leave blank to disable privileged WSL actions (status still works).
ABU_WSL_SUDO_PASS=
